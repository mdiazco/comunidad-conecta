{
  "name": "AuditLog",
  "type": "object",
  "properties": {
    "entity_type": {
      "type": "string",
      "description": "Tipo de entidad afectada"
    },
    "entity_id": {
      "type": "string",
      "description": "ID de la entidad"
    },
    "action": {
      "type": "string",
      "enum": [
        "create",
        "update",
        "delete",
        "status_change"
      ],
      "description": "Acci\u00f3n realizada"
    },
    "user_email": {
      "type": "string",
      "description": "Email del usuario que realiz\u00f3 la acci\u00f3n"
    },
    "user_name": {
      "type": "string",
      "description": "Nombre del usuario"
    },
    "details": {
      "type": "string",
      "description": "Detalles del cambio"
    },
    "community_id": {
      "type": "string",
      "description": "ID de la comunidad"
    }
  },
  "required": [
    "entity_type",
    "entity_id",
    "action",
    "user_email"
  ]
}