{
  "name": "CommitteeVote",
  "type": "object",
  "rls": {
    "read": {
      "$or": [
        {
          "data.voter_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "properties": {
    "task_id": {
      "type": "string",
      "description": "ID de la tarea asociada"
    },
    "community_id": {
      "type": "string",
      "description": "ID de la comunidad"
    },
    "voter_email": {
      "type": "string",
      "description": "Email del miembro del comit\u00e9 que vota"
    },
    "voter_name": {
      "type": "string",
      "description": "Nombre del votante"
    },
    "vote": {
      "type": "string",
      "enum": [
        "approve",
        "reject"
      ],
      "description": "Voto: aprobar o rechazar"
    },
    "comment": {
      "type": "string",
      "description": "Comentario del votante"
    },
    "budget_id": {
      "type": "string",
      "description": "ID del presupuesto sugerido al momento del voto"
    },
    "voted_at": {
      "type": "string",
      "description": "Fecha y hora del voto (ISO)"
    },
    "round": {
      "type": "number",
      "default": 1,
      "description": "N\u00famero de ronda de votaci\u00f3n a la que pertenece este voto"
    }
  },
  "required": [
    "task_id",
    "community_id",
    "voter_email",
    "vote"
  ]
}