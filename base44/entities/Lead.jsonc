{
  "name": "Lead",
  "type": "object",
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "superadmin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "superadmin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "superadmin"
          }
        }
      ]
    }
  },
  "properties": {
    "full_name": {
      "type": "string",
      "description": "Nombre completo del interesado"
    },
    "rut": {
      "type": "string",
      "description": "RUT del interesado"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Email de contacto"
    },
    "phone": {
      "type": "string",
      "description": "Tel\u00e9fono de contacto"
    },
    "status": {
      "type": "string",
      "enum": [
        "nuevo",
        "contactado",
        "autorizado",
        "descartado"
      ],
      "default": "nuevo",
      "description": "Estado del lead"
    }
  },
  "required": [
    "full_name",
    "rut",
    "email",
    "phone"
  ]
}