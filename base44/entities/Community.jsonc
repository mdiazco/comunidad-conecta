{
  "name": "Community",
  "type": "object",
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "properties": {
    "name": {
      "type": "string",
      "description": "Nombre de la comunidad"
    },
    "address": {
      "type": "string",
      "description": "Direcci\u00f3n"
    },
    "region": {
      "type": "string",
      "description": "Regi\u00f3n"
    },
    "comuna": {
      "type": "string",
      "description": "Comuna"
    },
    "type": {
      "type": "string",
      "enum": [
        "edificio",
        "condominio"
      ],
      "description": "Tipo de comunidad"
    },
    "units": {
      "type": "number",
      "description": "N\u00famero de unidades"
    },
    "rut": {
      "type": "string",
      "description": "RUT de la comunidad"
    },
    "contact_email": {
      "type": "string",
      "description": "Email de contacto del comit\u00e9"
    },
    "description": {
      "type": "string",
      "description": "Descripci\u00f3n"
    },
    "year_built": {
      "type": "number",
      "description": "A\u00f1o de construcci\u00f3n"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    },
    "approval_mode": {
      "type": "string",
      "enum": [
        "majority",
        "unanimity"
      ],
      "default": "majority",
      "description": "Modo de aprobaci\u00f3n del comit\u00e9: mayor\u00eda simple o unanimidad"
    },
    "min_committee_votes": {
      "type": "number",
      "default": 1,
      "description": "M\u00ednimo de votos del comit\u00e9 requeridos para que el resultado sea v\u00e1lido"
    },
    "admin_can_veto": {
      "type": "boolean",
      "default": true,
      "description": "Si el administrador puede vetar la decisi\u00f3n del comit\u00e9"
    },
    "amount_threshold": {
      "type": "number",
      "default": 0,
      "description": "Monto en CLP sobre el cual el flujo de presupuestos es obligatorio aunque requires_budget sea false. 0 = desactivado"
    },
    "voting_deadline_days": {
      "type": "number",
      "default": 7,
      "description": "D\u00edas de plazo por defecto para cada ronda de votaci\u00f3n del comit\u00e9"
    },
    "allow_admin_committee_double_role": {
      "type": "boolean",
      "default": false,
      "description": "Si se permite que un admin que vot\u00f3 como comit\u00e9 tambi\u00e9n d\u00e9 la aprobaci\u00f3n final (comunidades peque\u00f1as). Se registra en AuditLog."
    },
    "max_voting_rounds": {
      "type": "number",
      "default": 3,
      "description": "M\u00e1ximo de rondas de votaci\u00f3n antes de que el admin deba decidir manualmente"
    }
  },
  "required": [
    "name",
    "address",
    "region",
    "comuna",
    "type",
    "units",
    "rut",
    "contact_email"
  ]
}